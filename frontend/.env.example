# URL del backend. Dejar vacío si el front y la API se sirven desde el mismo dominio (recomendado, vía nginx).
VITE_API_URL=

# true = modo e-commerce (muestra precios y stock). false = modo catálogo.
VITE_MOSTRAR_PRECIOS=false

# Solo desarrollo: a dónde redirige Vite /api y /uploads
# VITE_DEV_BACKEND=http://localhost:3000
