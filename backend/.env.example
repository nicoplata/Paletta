NODE_ENV=production
PORT=3000

# Base de datos: DATABASE_URL o las variables sueltas
# DATABASE_URL=postgres://paletta:CLAVE@localhost:5432/paletta
DB_HOST=localhost
DB_PORT=5432
DB_NAME=paletta
DB_USER=paletta
DB_PASSWORD=cambiar
DB_SSL=false

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Orígenes permitidos (separados por coma). Si el front y la API van por el mismo dominio vía nginx, alcanza con el dominio.
CORS_ORIGINS=https://www.paletta.com.ar,https://paletta.com.ar
# Cantidad de proxies delante (nginx = 1)
TRUST_PROXY=1

UPLOAD_MAX_MB=5

# Mail (opcional). Si no se completa, los mensajes de contacto igual quedan guardados en el panel.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Paletta <no-reply@paletta.com.ar>"
CONTACT_TO=

# Solo para "npm run seed"
# ADMIN_EMAIL=admin@paletta.com.ar
# ADMIN_PASSWORD=

# URL pública del sitio (links en mails y retorno de Mercado Pago)
SITE_URL=https://www.paletta.com.ar

# Carpeta del build del frontend: el backend la usa para armar las páginas de producto y colegio
# con metadatos para WhatsApp/Facebook/Google. Por defecto: ../frontend/dist
# FRONTEND_DIST=/var/www/paletta/frontend/dist

# ---- Tienda online ----
TIENDA_HABILITADA=false
ENVIO_HABILITADO=true
ENVIO_COSTO=0
RETIRO_DIRECCION="Vélez Sarsfield 4270, Munro, Buenos Aires"
# Minutos que se reserva el stock esperando el pago con Mercado Pago / horas para transferencia
PEDIDO_VENCIMIENTO_MP_MIN=60
PEDIDO_VENCIMIENTO_TRANSFERENCIA_HS=48
MAX_UNIDADES_POR_ITEM=50
PEDIDOS_POR_HORA=20

# Mercado Pago Checkout Pro: credenciales en https://www.mercadopago.com.ar/developers/panel/app
# El webhook se configura en "Webhooks" apuntando a https://www.paletta.com.ar/api/pagos/webhook (evento: Pagos)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Transferencia bancaria (si se completa alias o CBU, se ofrece como método de pago)
TRANSFERENCIA_ALIAS=
TRANSFERENCIA_CBU=
TRANSFERENCIA_TITULAR=
TRANSFERENCIA_BANCO=
