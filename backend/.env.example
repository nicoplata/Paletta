NODE_ENV=production
PORT=3000

# Base de datos: DATABASE_URL o las variables sueltas
# DATABASE_URL=postgres://paletta:CLAVE@localhost:5432/paletta
DB_HOST=localhost
DB_PORT=5432
DB_NAME=paletta
DB_USER=paletta
DB_PASSWORD=cambiar
DB_SSL=false

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Orígenes permitidos (separados por coma). Si el front y la API van por el mismo dominio vía nginx, alcanza con el dominio.
CORS_ORIGINS=https://www.paletta.com.ar,https://paletta.com.ar
# Cantidad de proxies delante (nginx = 1)
TRUST_PROXY=1

UPLOAD_MAX_MB=5

# Mail (opcional). Si no se completa, los mensajes de contacto igual quedan guardados en el panel.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Paletta <no-reply@paletta.com.ar>"
CONTACT_TO=

# Solo para "npm run seed"
# ADMIN_EMAIL=admin@paletta.com.ar
# ADMIN_PASSWORD=
